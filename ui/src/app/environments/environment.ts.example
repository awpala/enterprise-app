/**
 * Placeholder for environment.ts.
 *
 * The real environment.ts is auto-generated at install/build time by
 * ui/scripts/generate-environment.mjs and is gitignored. This example exists
 * so the Angular fileReplacements target in angular.json is visible in the
 * repo and new contributors know where the value comes from.
 *
 * To regenerate manually:
 *   API_URL="https://<api-fqdn>" \
 *   AAD_AUTHORITY="https://<tenant>.ciamlogin.com/<tenantId>" \
 *   AAD_CLIENT_ID="<spa-app-client-id>" \
 *   AAD_TENANT_ID="<tenantId>" \
 *   AAD_API_SCOPE="api://<api-app-client-id>/access_as_user" \
 *   ENABLE_DEV_AUTH="false" \
 *   ENABLE_GUEST_AUTH="false" \
 *     node ui/scripts/generate-environment.mjs
 */
export const environment = {
  production: true,
  apiUrl: '',
  aadAuthority: '',
  aadClientId: '',
  aadTenantId: '',
  aadApiScope: '',
  enableDevAuth: false,
  enableGuestAuth: false,
};
