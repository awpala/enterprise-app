#!/usr/bin/env bash
# Auto-generated by `terraform output -raw gh_setup_commands` from infra/azure/bootstrap/.
# This script configures the GitHub repo with the secrets + variables + Environments
# required by the CI/CD workflows. Requires `gh auth login` with `repo` scope.
set -euo pipefail

REPO="${repo}"

echo ">> Creating GitHub Environments (idempotent)"
%{ for env in environments ~}
gh api -X PUT "repos/$REPO/environments/${env}" --silent
%{ endfor ~}

echo ">> Setting repo-level secrets (Azure OIDC identity)"
gh secret set AZURE_CLIENT_ID       --repo "$REPO" --body "${azure_client_id}"
gh secret set AZURE_TENANT_ID       --repo "$REPO" --body "${azure_tenant_id}"
gh secret set AZURE_SUBSCRIPTION_ID --repo "$REPO" --body "${azure_subscription_id}"

echo ">> Setting repo-level variables (tfstate backend — not secret, but handy to centralise)"
gh variable set TFSTATE_RESOURCE_GROUP  --repo "$REPO" --body "${tfstate_resource_group}"
gh variable set TFSTATE_STORAGE_ACCOUNT --repo "$REPO" --body "${tfstate_storage_account}"
gh variable set TFSTATE_CONTAINER       --repo "$REPO" --body "${tfstate_container}"

cat <<'EOF'

>> MANUAL FOLLOW-UP — Entra External ID (customer SSO) secrets
>>
>> This bootstrap wires up the workforce-tenant GitHub OIDC SP. The root
>> infra's `azuread.external` provider authenticates against a SECOND
>> tenant (Entra External ID / CIAM) using a client-secret app
>> registration that must be created manually inside that tenant.
>>
>> The user flow, Google IDP, Email OTP, and Microsoft Account / Entra
>> ID multi-tenant social providers are NOT managed by Terraform — they
>> are configured once in the Azure Portal. See
>> docs/runbooks/azure-sso-manual-bootstrap.md. No google_oidc_* TF_VAR_ secrets
>> are consumed by the root module anymore.
>>
>> Naming convention: GitHub secrets/variables are stored WITHOUT the
>> `TF_VAR_` prefix (matching AZURE_CLIENT_ID, AZURE_TENANT_ID, etc.).
>> The deploy workflow's job-level `env:` block performs the
>> `TF_VAR_*` mapping — see .github/workflows/deploy-azure.yml.
>>
>> Note: TENANT_SUBDOMAIN is a `gh variable` (non-sensitive tenant
>> subdomain like `contoso`), not a secret.
>>
>> After creating the External ID tenant, run the following (values are
>> per-Environment, NOT repo-wide):
>>
>>   # Per Azure Environment:
>>   ENV=azure-dev   # or: azure-production
>>   gh secret   set EXTERNAL_TENANT_ID            --env "$ENV" --body "<extid-tenant-id-guid>"
>>   gh variable set TENANT_SUBDOMAIN              --env "$ENV" --body "<tenant-subdomain>"
>>   gh secret   set EXTERNAL_TENANT_CLIENT_ID     --env "$ENV" --body "<client-id-from-ExtID-tenant>"
>>   gh secret   set EXTERNAL_TENANT_CLIENT_SECRET --env "$ENV" --body "<client-secret-from-ExtID-tenant>"
>>
>> Also required ONCE (admin consent for the Graph app-roles this bootstrap
>> just assigned to the CI SP — needed so Terraform can manage app
>> registrations in the WORKFORCE tenant; the External ID tenant needs its
>> own separate admin consent against the app created inside it):
>>
>>   az ad app permission admin-consent --id ${azure_client_id}
>>
>> Placeholders in infra/azure/envs/{dev,production}.tfvars (external_tenant_id,
>> tenant_subdomain) must also be filled in with the values recorded from
>> the manual External ID tenant creation step. See docs/runbooks for the
>> full SSO bootstrap procedure.

EOF

echo ">> Done. Push to a non-main branch to deploy to dev; push to main to deploy to production."
