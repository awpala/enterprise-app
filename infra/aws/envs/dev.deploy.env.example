# Copy to dev.deploy.env. The copied file is ignored by Git.
AWS_PROFILE=ea-bootstrap
AWS_REGION=us-east-1
AWS_NAME_SUFFIX=replace1
GITHUB_OWNER=awpala
GITHUB_REPO=enterprise-app
# Push routing: non-main branches deploy dev; main deploys production.
DEPLOYMENT_TARGETS=aws
COGNITO_DOMAIN_PREFIX=replace-with-globally-unique-prefix
AWS_MONTHLY_BUDGET_USD=100

# Optional email subscriber for the 80% actual-spend alert.
AWS_BUDGET_EMAIL=

# The Git ref containing the AWS workflow and code to deploy.
DEPLOY_REF=main

# Required only for production. Use user:<login> or team:<organization-team-slug>.
GITHUB_PRODUCTION_REVIEWER=
