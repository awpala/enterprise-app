# Local development only. Cloud deployments read secrets from their selected
# provider's secret store and never load this file.

# Values below must match the hardcoded dev connection string in
# api/src/EA.Api/appsettings.Development.json (postgres/password/postgres for DB,
# guest/guest for RabbitMQ). Changing them here without updating that file will
# break local `dotnet run` against the devcontainer DB / broker.

# postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# pgadmin
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_CONFIG_SERVER_MODE=
PGADMIN_CONFIG_MASTER_PASSWORD_REQUIRED=

# rabbitmq
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Next.js public runtime configuration. Local Compose supplies these values;
# they are listed here for direct `npm run dev` sessions.
DEPLOYMENT_TARGET=local
API_URL=
AUTH_PROVIDER=none
AUTH_AUTHORITY=
AUTH_CLIENT_ID=
AUTH_API_SCOPE=
AUTH_LOGOUT_ENDPOINT=
ENABLE_DEV_AUTH=true
ENABLE_GUEST_AUTH=false

# observability (optional)
# Provider adapters inject exporter settings into deployed services. This local
# file plays no role there.
# For local dev this is OPTIONAL: leave empty and the .NET API + Python
# data-engine guard on its absence (no telemetry export, stdout logging
# continues unchanged).
# Select `azuremonitor`, `otlp`, or `none` explicitly.
OBSERVABILITY_EXPORTER=none
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_EXPORTER_OTLP_ENDPOINT=
